# Copy this file to .env.local and fill in your Auth0 credentials.
# Auth0 Dashboard → Applications → your SPA app → Settings

# SPA Application (used for user login)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id

# Management API Application (used for user management features)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_MGMT_CLIENT_ID=your_mgmt_client_id
AUTH0_MGMT_CLIENT_SECRET=your_mgmt_client_secret
AUTH0_MGMT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# Auth0 dashboard checklist before login will work:
# 1. SPA Application → Settings → Advanced → Grant Types → enable "Password"
# 2. Tenant Settings → API Authorization Settings → Default Directory = "Username-Password-Authentication"
# 3. SPA Application → Settings → Allowed Web Origins → add http://localhost:5173

# SMTP (used for transactional email via /api/email/send)
# Use port 587 for STARTTLS (recommended) or 465 for SMTPS.
# Do NOT prefix these with VITE_ — they are server-side secrets only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@activateswag.com
SMTP_PASS=your_smtp_password
SMTP_FROM=ActivateSwag <noreply@activateswag.com>
# Optional: override the company name shown in invite emails (defaults to "ActivateSwag")
COMPANY_NAME=ActivateSwag
